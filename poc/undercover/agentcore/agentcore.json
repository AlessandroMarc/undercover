{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "undercover",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "undercover",
    "project": "undercover"
  },
  "runtimes": [
    {
      "name": "undercover_agent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/undercover_agent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 60
      },
      "envVars": [
        {
          "name": "UNDERCOVER_GATEWAY_URL",
          "value": "written by runtime.ipynb"
        }
      ],
      "additionalPolicies": [
        "gateway_policy.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "undercoverOpenAI"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
